# Host maps 5012 → container 5000 (avoid clash with Businessclass 5011)
PORT=5012
DUFFEL_API=your_duffel_token_here
# Local Mongo: mongodb://127.0.0.1:27017/atb
# Docker Compose: mongodb://mongo:27017/atb
MONGO_URL=mongodb://127.0.0.1:27017/atb
# Gmail SMTP for booking/quote emails (app password, not login password)
USER_EMAIL=your_gmail@gmail.com
EMAIL_PASS_ID=your_gmail_app_password
QUOTE_TO_EMAIL=Support@airlinesticketbooking.com
FRONTEND_URL=https://www.airlinesticketbooking.com
